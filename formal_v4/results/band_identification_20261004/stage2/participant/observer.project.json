{
  "schema_version": "observer-project-v1",
  "protocol": "jsonl-v4",
  "image": "python:3.12-slim",
  "build": [
    [
      "python3",
      "-m",
      "pip",
      "install",
      "--no-cache-dir",
      "--disable-pip-version-check",
      "--target",
      ".deps",
      "numpy==2.2.6"
    ]
  ],
  "run": [
    "python3",
    "-u",
    "-m",
    "research.agent_geometry_native"
  ],
  "working_directory": ".",
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONPATH": ".deps",
    "OPENBLAS_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1",
    "GEOMETRY_NATIVE_PLANNER": "sweep"
  }
}
